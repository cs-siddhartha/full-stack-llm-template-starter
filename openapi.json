{
  "components": {
    "schemas": {
      "ApiError": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "ConfigRead": {
        "properties": {
          "generation_model": {
            "title": "Generation Model",
            "type": "string"
          },
          "generation_provider": {
            "title": "Generation Provider",
            "type": "string"
          },
          "rate_limit_requests": {
            "title": "Rate Limit Requests",
            "type": "integer"
          },
          "rate_limit_window_seconds": {
            "title": "Rate Limit Window Seconds",
            "type": "integer"
          }
        },
        "required": [
          "generation_provider",
          "generation_model",
          "rate_limit_requests",
          "rate_limit_window_seconds"
        ],
        "title": "ConfigRead",
        "type": "object"
      },
      "GenerationCreate": {
        "additionalProperties": false,
        "properties": {
          "instructions": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "prompt": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
          "temperature": {
            "default": 0.0,
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "GenerationCreate",
        "type": "object"
      },
      "GenerationRead": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "output": {
            "title": "Output",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "usage": {
            "$ref": "#/components/schemas/GenerationUsage"
          }
        },
        "required": [
          "id",
          "provider",
          "model",
          "output",
          "usage"
        ],
        "title": "GenerationRead",
        "type": "object"
      },
      "GenerationUsage": {
        "properties": {
          "input_characters": {
            "minimum": 0.0,
            "title": "Input Characters",
            "type": "integer"
          },
          "output_characters": {
            "minimum": 0.0,
            "title": "Output Characters",
            "type": "integer"
          }
        },
        "required": [
          "input_characters",
          "output_characters"
        ],
        "title": "GenerationUsage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthRead": {
        "properties": {
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "healthy",
            "default": "healthy",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "environment"
        ],
        "title": "HealthRead",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBasic": {
        "scheme": "basic",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "A reusable, provider-neutral API for LLM applications.",
    "title": "Reusable LLM API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/config": {
      "get": {
        "operationId": "read_config_api_v1_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "summary": "Read runtime capabilities",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/generations": {
      "post": {
        "operationId": "create_generation_api_v1_generations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerationRead"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Authentication required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Generation rate limit exceeded",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Limit": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Reset": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "summary": "Create a text generation",
        "tags": [
          "generations"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "read_health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read service health",
        "tags": [
          "system"
        ]
      }
    }
  }
}
