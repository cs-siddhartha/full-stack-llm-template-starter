APP_NAME=LLM API
ENVIRONMENT=development
DEBUG=false

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=full-stack-starter

DEMO_LOGIN_ENABLED=true
SESSION_COOKIE_NAME=starter_session
SESSION_TTL_SECONDS=86400

RESEND_API_KEY=
RESEND_FROM_EMAIL=Starter <onboarding@resend.dev>
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
EMAIL_VERIFICATION_TTL_SECONDS=3600

LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
SIGNUP_RATE_LIMIT_REQUESTS=3
SIGNUP_RATE_LIMIT_WINDOW_SECONDS=300

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

CACHE_FLUSH_RATE_LIMIT_REQUESTS=3
CACHE_FLUSH_RATE_LIMIT_WINDOW_SECONDS=60
CONFIG_CACHE_TTL_SECONDS=30

LLM_MODEL=demo-v1
