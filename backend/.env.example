APP_NAME=Reusable LLM API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Accepts a comma-separated list or a JSON array.
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Required local examples. Use strong, matching values in the frontend environment.
BASIC_AUTH_USERNAME=local
BASIC_AUTH_PASSWORD=local-development-only

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

LLM_PROVIDER=demo
LLM_MODEL=demo-v1
